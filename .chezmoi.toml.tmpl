{{- /* Asked once on `chezmoi init`; re-ask with `chezmoi init --prompt` */ -}}
{{- $isWSL := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if contains "microsoft" (.chezmoi.kernel.osrelease | lower) -}}
{{-     $isWSL = true -}}
{{-   end -}}
{{- end -}}

{{- /* minimal is always included, so it is not offered as a choice */ -}}
{{- $extraProfiles := promptMultichoiceOnce . "extraProfiles" "Extra profiles (minimal is always included)" (list "gaming" "work") (list) -}}
{{- $profiles := concat (list "minimal") $extraProfiles -}}

{{- $gpus := list -}}
{{- $hyprland := false -}}
{{- $cosmic := false -}}
{{- $flatpak := false -}}
{{- if $isWSL -}}
{{-   $profiles = without $profiles "gaming" -}}
{{- else -}}
{{-   $gpus = promptMultichoiceOnce . "gpus" "GPU drivers (none is fine)" (list "intel" "amd" "nvidia") (list) -}}
{{-   if or (has "gaming" $profiles) (has "work" $profiles) -}}
{{-     $hyprland = promptBoolOnce . "hyprland" "Install Hyprland + Noctalia + Noctalia greeter" true -}}
{{-     $cosmic = promptBoolOnce . "cosmic" "Install COSMIC desktop (secondary)" false -}}
{{-   end -}}
{{-   $flatpak = promptBoolOnce . "flatpak" "Install Flatpak (with Flathub)" false -}}
{{- end -}}

{{- $theme := promptChoiceOnce . "theme" "Theme" (list "noctalia" "catppuccin") "noctalia" -}}
{{- $variant := promptChoiceOnce . "variant" "Variant" (list "dark" "light") "dark" -}}
{{- $devGroups := promptMultichoiceOnce . "devGroups" "Development package groups" (list "go" "python" "lua" "node" "postgres" "sqlite") (list "node" "python") -}}

[data]
    extraProfiles = {{ $extraProfiles | toJson }}
    theme = {{ $theme | quote }}
    variant = {{ $variant | quote }}
    devGroups = {{ $devGroups | toJson }}
    gpus = {{ $gpus | toJson }}
    isWSL = {{ $isWSL }}
    profiles = {{ $profiles | toJson }}
    hyprland = {{ $hyprland }}
    cosmic = {{ $cosmic }}
    flatpak = {{ $flatpak }}
    gui = {{ not $isWSL }}
